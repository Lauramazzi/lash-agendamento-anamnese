rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Agendamentos: Clientes leem (checar horarios e autopreencher ficha) e criam.
    // So a Admin autenticada pode alterar status ou excluir.
    match /bookings/{document} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    // Caixa, Estoque e Fechamentos: Apenas Admin autenticado le e altera
    match /products/{document} {
      allow read, write: if request.auth != null;
    }
    match /transactions/{document} {
      allow read, write: if request.auth != null;
    }
    match /closings/{document} {
      allow read, write: if request.auth != null;
    }
    // Servicos, Expediente, Bloqueios e Configuracoes: Clientes leem (publico), Admin altera
    match /services/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /blocked_dates/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
